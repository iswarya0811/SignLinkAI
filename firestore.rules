rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- User Rules ---
    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.totalPoints is int && data.totalPoints >= 0 &&
             (data.displayName == null || (data.displayName is string && data.displayName.size() <= 100)) &&
             (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (data.completedLessons == null || (data.completedLessons is list && data.completedLessons.size() <= 1000));
    }

    function isValidProgress(data) {
      return data.userId == request.auth.uid &&
             data.lessonId is string && data.lessonId.size() <= 100 &&
             data.score is int && data.score >= 0 && data.score <= 100 &&
             data.completed is bool;
    }

    // Connection Test Document
    match /test/connection {
      allow get: if true;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        // Action: Update Profile
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'totalPoints', 'completedLessons', 'updatedAt'])
      );
      
      match /progress/{lessonId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidProgress(incoming());
      }
    }

    // --- Lesson Rules ---
    match /lessons/{lessonId} {
      allow read: if isSignedIn();
      allow write: if false; // Only system/admin (via console)
    }
  }
}
